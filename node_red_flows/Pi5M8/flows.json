    {
        "id": "cd608b02fbb2fc8d",
        "type": "function",
        "z": "5c0b7d940b2a05ad",
        "g": "9bf524ada07cb331",
        "name": "calculate",
        "func": "const Rtop = 5100;\nconst Rbottom = 10000;\nconst k = (Rtop + Rbottom) / Rbottom; // ≈ 1.51\n\nconst v_adc1 = msg.payload[\"/dev/i2c-1\"].ads1115[\"0x48\"].singleEnded.channel_0.Volts; \nmsg.payload.ai1  = (v_adc1 * k).toFixed(2); // v\n\nconst v_adc2 = msg.payload[\"/dev/i2c-1\"].ads1115[\"0x48\"].singleEnded.channel_1.Volts;\nmsg.payload.ai2 = (v_adc2 * k).toFixed(2);\n\n\nconst Rshunt = 150;          \n\nconst v_adc3 = msg.payload[\"/dev/i2c-1\"].ads1115[\"0x48\"].singleEnded.channel_2.Volts; \nconst i3 = v_adc3 / Rshunt;       \nmsg.payload.ai3 = (i3 * 1000).toFixed(2);          // mA\n\nconst v_adc4 = msg.payload[\"/dev/i2c-1\"].ads1115[\"0x48\"].singleEnded.channel_3.Volts; \nconst i4 = v_adc4 / Rshunt;       \nmsg.payload.ai4 = (i4 * 1000).toFixed(2);          // mA\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
